{
  "name": "openprint-community",
  "version": "0.6.0",
  "private": true,
  "description": "An open workshop for 3D printing, engineering, and local maker communities. Self-hosted, no cloud account required.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "build": "tsc -p tsconfig.server.json && node scripts/build-locales.mjs && vite build",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run i18n:check && npm run typecheck && npm test && npm run build",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check && node scripts/check-i18n-manifest.mjs && node scripts/render-readmes.mjs --check",
    "admin": "node --import tsx scripts/admin.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "cleanup": "node --import tsx scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:eval": "node --import tsx scripts/ai-eval.ts",
    "catalog:import": "node --import tsx scripts/catalog-import.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
