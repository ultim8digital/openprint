# Copy to .env. Node 24 loads this file locally. No API keys are required.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.local/data
INSTANCE_NAME=OpenPrint
# Default: public catalogue, immediate self-publication, no accounts or moderators.
# Set community only to enable the optional private projects/CAD/account workflows.
APP_MODE=catalog
# Optional comma-separated origins of independent OpenPrint nodes. See docs/WORKSHOP_NETWORK.md.
OPENPRINT_PEERS=
# Set off to display pins and lists without requesting external OpenStreetMap tiles.
MAP_TILES=osm
# Public contact for the operator. Use your HTTPS help page or mailto: address.
OPERATOR_CONTACT=
# Set APP_URL to your HTTPS URL behind your reverse proxy.
# TRUST_PROXY=1 only when ONE trusted proxy is the only way to reach this process.
TRUST_PROXY=0
MAX_STORAGE_MB=1024
USER_STORAGE_MB=200

# Optional Neofab Studio assistant. Keep the key on this server, never in VITE_* or Git.
# No key = complete manual brief/BOM and template workflow; no AI calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REVIEW_MODEL=gpt-6.1-sol
# CAD proposals use the technical model; blank inherits OPENAI_REVIEW_MODEL.
OPENAI_CAD_MODEL=
# Hard attempt and output-token limits, not a USD spending guarantee.
STUDIO_AI_MAX_PROJECT_CALLS=3
STUDIO_AI_MAX_USER_DAILY_CALLS=10
STUDIO_AI_MAX_DAILY_CALLS=50
STUDIO_AI_MAX_OUTPUT_TOKENS=3000
STUDIO_AI_CAD_MAX_OUTPUT_TOKENS=8000

# Optional local CAD engine. Install cad-worker/requirements.txt in a Python 3.12 venv.
# Absolute path only; never a shell command. See docs/CAD_ENGINE.md.
CAD_PYTHON=
