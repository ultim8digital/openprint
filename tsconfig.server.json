{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "build",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "scripts/*.ts"]
}
